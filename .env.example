APP_MODE=local
SERVER_ADDRESS=127.0.0.1
PERSONAL_USERNAME=local-user
PERSONAL_TOKEN=replace-with-a-local-password
AZURE_OPENAI_ENDPOINT=https://replace-with-primary-endpoint
AZURE_OPENAI_USE_ALTERNATE_IMAGE_ENDPOINT=true
AZURE_OPENAI_ALT_IMAGE_ENDPOINT=https://replace-with-image-endpoint
AZURE_OPENAI_ALT_IMAGE_API_KEY=replace-with-image-key
STORAGE_ACCOUNT_NAME=replace-with-storage-account
STORAGE_CONTAINER_NAME=images
AZURE_STORAGE_CONNECTION_STRING=replace-with-storage-connection-string
